output "environment_deployed" {
  value       = local.environment
  description = "The active workspace tier successfully deployed"
}

output "vpc_id" {
  value       = module.vpc.vpc_id
  description = "The unique tracking ID generated by AWS for the VPC network layer"
}

output "subnet_id" {
  value       = module.vpc.subnet_id
  description = "The public subnet deployment ID container"
}

output "security_group_id" {
  value       = module.security_group.sg_id
  description = "The applied firewall profile dynamic ID mapping"
}

output "ec2_public_ip" {
  value       = module.ec2_instance.public_ip
  description = "The live public IPv4 network endpoint address of the server instance"
}
